<UserControl x:Class="FlowGPTBridge.Settings.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="660">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="FlowGPT Bridge" />
            <TextBlock Margin="0,6,0,18"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Text="如果在 ChatGPT 中修改了快捷键，也要在这里同步修改。插件不会自动粘贴或发送。" />

            <TextBlock FontWeight="SemiBold" Text="操作快捷键" />
            <Grid Margin="0,10,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Chat" />
                <TextBox x:Name="ChatHotkeyText" Grid.Row="0" Grid.Column="1" Margin="4" IsReadOnly="True" />
                <Button Grid.Row="0" Grid.Column="2" Margin="4" Padding="10,4" Content="录制" Tag="Chat" Click="RecordHotkey_Click" />
                <Button Grid.Row="0" Grid.Column="3" Margin="4" Padding="10,4" Content="清除" Tag="Chat" Click="ClearHotkey_Click" />
                <Button Grid.Row="0" Grid.Column="4" Margin="4" Padding="10,4" Content="测试" Tag="Chat" Click="TestHotkey_Click" />
                <Button Grid.Row="0" Grid.Column="5" Margin="4" Padding="10,4" HorizontalAlignment="Left" Content="恢复默认" Tag="Chat" Click="ResetHotkey_Click" />

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Work" />
                <TextBox x:Name="WorkHotkeyText" Grid.Row="1" Grid.Column="1" Margin="4" IsReadOnly="True" />
                <Button Grid.Row="1" Grid.Column="2" Margin="4" Padding="10,4" Content="录制" Tag="Work" Click="RecordHotkey_Click" />
                <Button Grid.Row="1" Grid.Column="3" Margin="4" Padding="10,4" Content="清除" Tag="Work" Click="ClearHotkey_Click" />
                <Button Grid.Row="1" Grid.Column="4" Margin="4" Padding="10,4" Content="测试" Tag="Work" Click="TestHotkey_Click" />
                <Button Grid.Row="1" Grid.Column="5" Margin="4" Padding="10,4" HorizontalAlignment="Left" Content="恢复默认" Tag="Work" Click="ResetHotkey_Click" />

                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Codex" />
                <TextBox x:Name="CodexHotkeyText" Grid.Row="2" Grid.Column="1" Margin="4" IsReadOnly="True" />
                <Button Grid.Row="2" Grid.Column="2" Margin="4" Padding="10,4" Content="录制" Tag="Codex" Click="RecordHotkey_Click" />
                <Button Grid.Row="2" Grid.Column="3" Margin="4" Padding="10,4" Content="清除" Tag="Codex" Click="ClearHotkey_Click" />
                <Button Grid.Row="2" Grid.Column="4" Margin="4" Padding="10,4" Content="测试" Tag="Codex" Click="TestHotkey_Click" />
                <Button Grid.Row="2" Grid.Column="5" Margin="4" Padding="10,4" HorizontalAlignment="Left" Content="恢复默认" Tag="Codex" Click="ResetHotkey_Click" />

                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="新聊天" />
                <TextBox x:Name="NewChatHotkeyText" Grid.Row="3" Grid.Column="1" Margin="4" IsReadOnly="True" />
                <Button Grid.Row="3" Grid.Column="2" Margin="4" Padding="10,4" Content="录制" Tag="NewChat" Click="RecordHotkey_Click" />
                <Button Grid.Row="3" Grid.Column="3" Margin="4" Padding="10,4" Content="清除" Tag="NewChat" Click="ClearHotkey_Click" />
                <Button Grid.Row="3" Grid.Column="4" Margin="4" Padding="10,4" Content="测试" Tag="NewChat" Click="TestHotkey_Click" />
                <Button Grid.Row="3" Grid.Column="5" Margin="4" Padding="10,4" HorizontalAlignment="Left" Content="恢复默认" Tag="NewChat" Click="ResetHotkey_Click" />
            </Grid>

            <TextBlock x:Name="RecordingHint"
                       Margin="0,-10,0,16"
                       Foreground="#D97706"
                       TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="默认 Prompt 模式" />
                <ComboBox x:Name="DefaultModeCombo"
                          Grid.Row="0" Grid.Column="1"
                          Margin="4" SelectionChanged="DefaultModeCombo_SelectionChanged" />

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="启动等待上限（毫秒）" />
                <TextBox x:Name="LaunchTimeoutText"
                         Grid.Row="1" Grid.Column="1"
                         Margin="4" LostFocus="LaunchTimeoutText_LostFocus" />

                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="调试日志" />
                <CheckBox x:Name="DebugLoggingCheck"
                          Grid.Row="2" Grid.Column="1"
                          Margin="4" Content="启用（不会记录 Prompt）"
                          Checked="DebugLoggingCheck_Changed"
                          Unchecked="DebugLoggingCheck_Changed" />
            </Grid>

            <Expander Margin="0,18,0,0" Header="高级启动设置（可选）">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="ChatGPT.exe 路径" />
                    <TextBox x:Name="ExecutablePathText"
                             Grid.Row="0" Grid.Column="1" Margin="4"
                             LostFocus="AdvancedSetting_LostFocus" />

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="AppUserModelID" />
                    <TextBox x:Name="AppUserModelIdText"
                             Grid.Row="1" Grid.Column="1" Margin="4"
                             LostFocus="AdvancedSetting_LostFocus" />
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
